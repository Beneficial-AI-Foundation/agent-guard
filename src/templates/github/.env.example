# Copy to .env in this folder. AgentGuard reads it; never commit it.

# The GitHub App (recommended) or OAuth App that `agentguard login` signs in with.
# It needs "Enable device flow" switched on. A GitHub App's tokens are limited to
# the repositories it is installed on, and expire.
AGENTGUARD_GITHUB_CLIENT_ID=

# Only for the local Docker server in mcp.json: a fine-grained token limited to
# the repositories the agent should touch.
GITHUB_PERSONAL_ACCESS_TOKEN=
